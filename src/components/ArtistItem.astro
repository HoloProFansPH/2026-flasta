---
interface iconsItem {
    iconsName: string;
    iconsAlt: string;
}
interface Props {
    icons?: Array<iconsItem>;
    artistName: string;
    artistTag: string;
}
const { icons, artistName, artistTag } = Astro.props;
---

<a class="artistItem" href={"https://twitter.com/" + artistTag}>
    <!-- <img height="32px" src={"/svg/" + icon + ".svg"} alt={iconAlt} /> -->
    <div style="display: flex; justify-content: end; gap: 0.5rem;">
        {icons
            ? icons.map(({ iconsName, iconsAlt }) => (
                  <img
                      height="32px"
                      src={"/svg/" + iconsName + ".svg"}
                      alt={iconsAlt}
                  />
              ))
            : ""}
    </div>
    <div class="artistInfo">
        <span class="artistName">{artistName}</span>
        <span>@{artistTag}</span>
    </div>
</a>
