---
import ProjectItem from "./ProjectItem.astro";
import Card from "./Card.astro";
---

<Card>
    <div class="cardHeader">
        <div style="display: flex; flex-direction: column; text-align: left;">
            <span class="cardTitle">Featured Projects</span>
            <span>
                More hololive production fan projects taking place during
                Cosplay Mania 2026!
            </span>
        </div>
    </div>
    <div class="tableFlex">
        <ProjectItem
            title="🎉 HoloMEETUP 2026"
            link="https://twitter.com/HoloProFansPH/status/2104541649007485282"
            description="hololive production cosplayers and fans meetup organized by HoloPro Fans PH"
        />
        <ProjectItem
            title="🌟 Unibersidad de Elysium Talagabahaghari"
            link="https://twitter.com/kimeyngo/status/2103700374528114766"
            description="HOLOSTARS English stamp rally"
        />
        <ProjectItem
            title="🍑🥟 Project Nene Bloom"
            link="https://twitter.com/yanami_cos/status/2097314358787518555"
            description="Flower stand for Momosuzu Nene with local art, organized by Yanami Cosplay"
        />
        <ProjectItem
            title="🔅 Melody in Bloom"
            link="https://twitter.com/SebbyBerry/status/2103072216405430409"
            description="Flower stand for Banzoin Hakka, organized by SebbyBerry"
        />
        <ProjectItem
            title="🦖 Campus Royalties: REX Batallion Partylist"
            link="https://twitter.com/SorawrityPH/status/2090770947657912729"
            description="Organized by Sorawrity PH"
        />
        <ProjectItem
            title="♾️ Campus Royalties: MY LODI Partylist"
            link="https://twitter.com/PHpoppet/status/2090770907887259860"
            description="Organized by PH Poppet"
        />
        <ProjectItem
            title="🍑🥟 Nekko Flower Stand"
            link="https://twitter.com/NeneProjectsEDF/status/2095705174731845873"
            description="Flower stand for Momosuzu Nene, organized by Nene Productions Co., Ltd"
        />
    </div>
</Card>
